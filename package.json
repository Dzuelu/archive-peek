{
  "name": "archive-peek",
  "displayName": "Archive Peek",
  "description": "Peek inside .zip, .7z, .rar, .tar, .gz, .bz2, .xz, .tar.gz, .tar.bz2, .tar.xz, .jar, .war, .vsix, .nupkg, .apk, .whl, .xpi, .epub, .aar archives without extracting them",
  "version": "0.0.0",
  "publisher": "Dzuelu",
  "repository": "https://github.com/Dzuelu/archive-peek",
  "engines": {
    "node": "22.x",
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "archive",
    "zip",
    "7z",
    "tar",
    "gz",
    "bz2",
    "xz",
    "tar.gz",
    "tar.bz2",
    "tar.xz",
    "whl",
    "xpi",
    "epub",
    "aar",
    "jar",
    "war",
    "vsix",
    "nupkg",
    "apk",
    "rar",
    "peek"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Archive Peek",
      "properties": {
        "archivePeek.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh opened archives, and any files opened from them, when the archive changes on disk."
        }
      }
    },
    "commands": [
      {
        "command": "archivePeek.openArchive",
        "title": "Open Archive",
        "category": "Archive Peek",
        "icon": "$(file-zip)"
      },
      {
        "command": "archivePeek.refresh",
        "title": "Refresh Archives",
        "category": "Archive Peek",
        "icon": "$(refresh)"
      },
      {
        "command": "archivePeek.closeArchive",
        "title": "Close Archive",
        "category": "Archive Peek",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "archivePeek.openArchive",
          "when": "resourceExtname == .zip || resourceExtname == .7z || resourceExtname == .gz || resourceExtname == .bz2 || resourceExtname == .xz || resourceExtname == .tar || resourceExtname == .jar || resourceExtname == .war || resourceExtname == .ear || resourceExtname == .vsix || resourceExtname == .nupkg || resourceExtname == .apk || resourceExtname == .whl || resourceExtname == .xpi || resourceExtname == .epub || resourceExtname == .aar || resourceExtname == .rar || resourceExtname == .tgz || resourceExtname == .tbz2 || resourceExtname == .txz",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "archivePeek.archiveEditor",
        "displayName": "Archive Peek",
        "selector": [
          {
            "filenamePattern": "*.zip"
          },
          {
            "filenamePattern": "*.7z"
          },
          {
            "filenamePattern": "*.tar"
          },
          {
            "filenamePattern": "*.tar.gz"
          },
          {
            "filenamePattern": "*.tgz"
          },
          {
            "filenamePattern": "*.tar.bz2"
          },
          {
            "filenamePattern": "*.tbz2"
          },
          {
            "filenamePattern": "*.tar.xz"
          },
          {
            "filenamePattern": "*.txz"
          },
          {
            "filenamePattern": "*.jar"
          },
          {
            "filenamePattern": "*.war"
          },
          {
            "filenamePattern": "*.ear"
          },
          {
            "filenamePattern": "*.vsix"
          },
          {
            "filenamePattern": "*.nupkg"
          },
          {
            "filenamePattern": "*.apk"
          },
          {
            "filenamePattern": "*.rar"
          },
          {
            "filenamePattern": "*.gz"
          },
          {
            "filenamePattern": "*.bz2"
          },
          {
            "filenamePattern": "*.xz"
          },
          {
            "filenamePattern": "*.whl"
          },
          {
            "filenamePattern": "*.xpi"
          },
          {
            "filenamePattern": "*.epub"
          },
          {
            "filenamePattern": "*.aar"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "validate": "npm run compile && npm run lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "bench:baseline": "vitest bench --run --outputJson bench-results/baseline.json && BENCH_LABEL=baseline vitest run --config vitest.memory.config.ts",
    "bench:compare": "vitest bench --run --outputJson bench-results/current.json && vitest run --config vitest.memory.config.ts && node scripts/bench-report.mjs",
    "bench:memory": "vitest run --config vitest.memory.config.ts"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "22.x",
    "@types/vscode": "~1.101.0",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vscode/vsce": "^4.0.0",
    "adm-zip": "^0.6.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2",
    "tar-stream": "^3.2.2",
    "unbzip2-stream": "^1.4.3",
    "xz-decompress": "^0.2.3",
    "yauzl": "^3.4.0"
  }
}
